10 REM CLAVIER DISTANT - 31250 BAUDS 7E1
20 B=31250:SERCFG 7E1
30 CLS:PRINT "CLAVIER: ATTENTE DU PC";
40 SEROPEN B:SEROUT 75:SEROUT 66:SEROUT 50:SEROUT 13
50 A=SERIN(0)
60 IF A=4 THEN 900
70 IF A<>6 THEN 50
80 K=INKEY(0)
90 CLS:PRINT "CLAVIER ACTIF - BREAK: FIN";
100 K=INKEY(0)
110 IF K=0 THEN 160
120 IF K<128 THEN SEROUT 64:SEROUT K:GOTO 100
130 SEROUT 65:SEROUT K-128:GOTO 100
160 IF SERIN(0)<>4 THEN 100
900 SEROUT 6:SERCLOSE:BAUD 31250
910 CLS:CURSOR 0:PRINT "CLAVIER FERME":END
