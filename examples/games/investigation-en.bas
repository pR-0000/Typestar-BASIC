10 REM INVESTIGATION - ERIC FLAMENT - TYPESTAR 1.0
20 CLS:CURSOR 4:PRINT "INVESTIGATION - GASTON'S CASE";
30 R=1
40 R=R MOD 60000+1:IF INKEY(0)=0 THEN 40
50 RANDOMIZE R:DIM A(1,9):DIM B(1,9):DIM M(1):DIM F(1)
60 X$="ALBERT  GUSTAVE DUDULE  HENRI   MARCEL  "
70 Y$="HÉLÈNE  KATIE   SYLVIE  ALINE   "
80 U$="THEATRE CAFE    PARK    CASINO  PALACE  "
90 V$="MARKET  GOLF    TENNIS  CINEMA  "
100 L=1+INT(RND(1)*9):V=0:Z=0:E=0
110 FOR I=0 TO 1:M(I)=1+INT(RND(1)*9)
120 FOR J=1 TO 9:A(I,J)=1+(J-1) MOD 3
130 B(I,J)=INT(RND(1)*4):NEXT J
140 A(I,M(I))=1+A(I,M(I)) MOD 3:B(I,M(I))=2
150 NEXT I
160 D=1+INT(RND(1)*9):IF D=M(0) THEN 160
170 T$="Gaston is dead. Who is lying?":GOSUB 9000
180 G=1+(M(0)-1) MOD 3:GOSUB 8100
190 GOSUB 9000:GOTO 210
200 IF V=0 AND Z>=6 THEN 6000
210 S=1
220 N=S:GOSUB 8000:CLS:PRINT S;" ";T$;" C";E+1;" < >";
230 GOSUB 9100:IF K=81 THEN 8500
240 IF K=18 THEN S=S-1:IF S=0 THEN S=9
250 IF K=19 THEN S=S+1:IF S=10 THEN S=1
260 IF K<>13 THEN 220
270 IF V=1 AND S=D THEN T$="This person is dead.":GOTO 6700
280 P=0
300 CLS:IF P=0 THEN PRINT "1 Place 2 Alibi 3 Knew   1/2";
310 IF P=1 THEN PRINT "4 Seen 5 Accuse 6 Case   2/2";
320 GOSUB 9100:IF K=8 THEN 210
330 IF K=18 OR K=19 THEN P=1-P:GOTO 300
340 IF K=49 THEN G=A(E,S):GOSUB 8100:GOTO 6500
350 IF K=50 THEN 400
360 IF K=51 THEN 420
370 IF K=52 THEN 440
380 IF K=53 THEN 500
390 IF K=54 THEN 550 ELSE GOTO 320
400 T$="No, I have no reliable alibi."
410 IF (B(E,S) AND 1)=1 THEN T$="Yes, I have a reliable alibi."
415 GOTO 6500
420 T$="No, I didn't know the victim."
430 IF (B(E,S) AND 2)=2 THEN T$="Yes, I knew the victim."
435 GOTO 6500
440 GOSUB 7000:IF N=0 THEN 300
450 IF N=S THEN T$="Choose a different person.":GOTO 6600
460 T$="No, I didn't see that person."
470 IF S=M(E) OR N=M(E) THEN 6500
480 IF (S-1) MOD 3=(N-1) MOD 3 THEN T$="Yes, we were together."
490 GOTO 6500
500 IF F(E)=1 THEN T$="This case is solved.":GOTO 6600
510 T$="Accuse who? Dead = suicide.":GOSUB 9000
520 GOSUB 7000:IF N=0 THEN 300
530 T$="Confirm accusation? Y/N":GOSUB 9000
535 IF K<>89 THEN 300
540 IF N<>M(E) THEN 8400
545 F(E)=1:T$="Well done! Case solved.":GOSUB 9000
547 IF F(0)+F(1)=2 THEN 8300
548 IF V=0 THEN 6000
549 E=1-E:GOTO 200
550 IF V=0 THEN T$="Only one case so far.":GOTO 6600
560 E=1-E:CLS:PRINT "CASE ";E+1;
570 IF E=0 THEN PRINT " GASTON";
580 IF E=1 THEN N=D:GOSUB 8000:PRINT " ";T$;
590 GOSUB 9100:GOTO 210
6000 V=1:T$="A second body has been found!":GOSUB 9000
6010 N=D:GOSUB 8000:CLS:PRINT "VICTIM: ";T$;
6020 GOSUB 9100:G=1+(M(1)-1) MOD 3:GOSUB 8100
6030 GOSUB 9000:E=1:GOTO 210
6500 GOSUB 9000:Z=Z+1
6510 IF V=0 AND Z>=6 THEN 6000
6520 GOTO 300
6600 GOSUB 9000:GOTO 300
6700 GOSUB 9000:GOTO 210
7000 N=1
7010 GOSUB 8000:CLS:PRINT "WHO? ";N;" ";T$;" < >";
7020 GOSUB 9100:IF K=8 THEN N=0:RETURN
7030 IF K=18 THEN N=N-1:IF N=0 THEN N=9
7040 IF K=19 THEN N=N+1:IF N=10 THEN N=1
7050 IF K=13 THEN RETURN ELSE GOTO 7010
8000 IF N<=5 THEN T$=MID$(X$,(N-1)*8+1,8):RETURN
8010 T$=MID$(Y$,(N-6)*8+1,8):RETURN
8100 G=1+(L+G-2) MOD 9
8110 IF G<=5 THEN T$=MID$(U$,(G-1)*8+1,8):RETURN
8120 T$=MID$(V$,(G-6)*8+1,8):RETURN
8300 T$="Both cases are solved!":GOTO 8600
8400 T$="Wrong accusation! You lose.":GOTO 8600
8500 T$="Investigation abandoned."
8600 GOSUB 9000:CLS:PRINT "QUESTIONS ASKED: ";Z;:END
9000 CLS:PRINT T$;:GOSUB 9100:RETURN
9100 IF INKEY(0)<>0 THEN 9100
9110 K=INKEY(0):IF K=0 THEN 9110
9120 IF K>=97 AND K<=122 THEN K=K-32
9130 RETURN
