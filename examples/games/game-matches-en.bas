10 REM MATCHES - TAKING THE LAST ONE LOSES
20 N=20
30 PRINT N;" MATCHES":GOSUB 500
40 INPUT "TAKE 1-3";A
50 IF A<>INT(A) THEN 40
60 IF A<1 THEN 40
70 IF A>3 THEN 40
80 IF A>N THEN 40
90 N=N-A
100 IF N=0 THEN 220
110 B=N-1-4*INT((N-1)/4)
120 IF B=0 THEN B=1
130 N=N-B
140 IF N=0 THEN 200
150 PRINT "I TAKE ";B;". LEFT: ";N:GOSUB 500
160 INPUT "TAKE 1-3";A
170 GOTO 50
200 PRINT "YOU WIN!":END
220 PRINT "YOU LOSE! LAST MATCH":END
500 K=INKEY(0):IF K=0 THEN 500
510 RETURN
