10 REM ALLUMETTES - PRENDRE LA DERNIERE FAIT PERDRE
20 N=20
30 PRINT N;" ALLUMETTES":GOSUB 500
40 INPUT "PRENDRE 1-3";A
50 IF A<>INT(A) THEN 40
60 IF A<1 THEN 40
70 IF A>3 THEN 40
80 IF A>N THEN 40
90 N=N-A
100 IF N=0 THEN 220
110 B=N-1-4*INT((N-1)/4)
120 IF B=0 THEN B=1
130 N=N-B
140 IF N=0 THEN 200
150 PRINT "JE PRENDS ";B;". RESTE ";N:GOSUB 500
160 INPUT "PRENDRE 1-3";A
170 GOTO 50
200 PRINT "GAGNE !":END
220 PRINT "PERDU ! DERNIERE ALLUMETTE":END
500 K=INKEY(0):IF K=0 THEN 500
510 RETURN
