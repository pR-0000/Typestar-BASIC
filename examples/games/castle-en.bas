10 REM CASTLE - ALAIN DUBUS - TYPESTAR 1.0
20 CLS:CURSOR 4:PRINT "CASTLE - RESCUE THE QUEEN";
30 S=1
40 S=S MOD 60000+1:IF INKEY(0)=0 THEN 40
50 RANDOMIZE S:DIM A(12):DIM B(4)
60 FOR I=0 TO 12
70 V=2+INT(RND(1)*35):F=0
80 IF I=0 THEN 120
90 FOR J=0 TO I-1
100 IF A(J)=V THEN F=1
110 NEXT J:IF F=1 THEN 70
120 A(I)=V:NEXT I
130 E=100:C=0:T=1
140 T$="8/N north 2/S south 4/6 arrows":GOSUB 9000
150 T$="Bring the queen back to room 1.":GOSUB 9000
160 T$="Each step costs 8 gold. Q: quit.":GOSUB 9000
200 CLS:PRINT "ROOM ";T;" GOLD ";E;
210 IF C=1 THEN PRINT " QUEEN";
220 GOSUB 9100:IF K=81 THEN 8000
230 U=T
240 IF K=56 OR K=78 THEN U=T-6
250 IF K=50 OR K=83 THEN U=T+6
260 IF K=52 OR K=18 OR K=87 THEN U=T-1
270 IF K=54 OR K=19 OR K=69 THEN U=T+1
280 IF U=T THEN 220
290 IF U<1 OR U>36 THEN 400
300 IF U=T-1 AND T MOD 6=1 THEN 400
310 IF U=T+1 AND T MOD 6=0 THEN 400
320 T=U
330 E=E-8:IF E<0 THEN 8100
340 IF C=1 AND T=1 THEN 8200
350 P=-1:FOR I=0 TO 12
360 IF A(I)=T THEN P=I
370 NEXT I:IF P<0 THEN 200
380 IF P<5 THEN 1000
390 A(P)=0:GOTO 2000
400 T$="A wall. Choose a direction.":GOSUB 9000
410 GOTO 200
1000 IF B(P)=1 THEN 200
1010 T$="BEAR":R=20+P*5
1020 IF P=1 THEN T$="OGRE"
1030 IF P=2 THEN T$="LION"
1040 IF P=3 THEN T$="DRACULA"
1050 IF P=4 THEN T$="DRAGON"
1060 CLS:PRINT T$;" F:FIGHT R:RUN";
1070 GOSUB 9100
1080 IF K=82 THEN E=E-10:GOTO 1130
1090 IF K<>70 THEN 1070
1100 IF RND(1)<0.4 THEN E=E-R:GOTO 1140
1110 B(P)=1:E=E+R:T$="Victory! The monster is beaten."
1120 GOSUB 9000:GOTO 3000
1130 T$="You flee! Lose 10 gold.":GOSUB 9000:GOTO 3000
1140 T$="Fight lost. You lose gold."
1150 GOSUB 9000:GOTO 3000
2000 IF P=5 THEN E=E+60:T$="Treasure! +60 gold":GOTO 2900
2010 IF P=6 THEN E=E+50:T$="Ruby! +50 gold":GOTO 2900
2020 IF P=7 THEN C=1:T$="The queen joins you!":GOTO 2900
2030 IF P=8 OR P=9 THEN 2100
2040 IF P=10 THEN 2200
2050 V=10+INT(RND(1)*50)
2060 IF V<15 THEN E=E-2*V:T$="The chest explodes!":GOTO 2900
2070 E=E+V:CLS:PRINT "CHEST: +";V;" GOLD";
2080 GOSUB 9100:GOTO 3000
2100 T$="Catapult! You are thrown away.":GOSUB 9000
2110 T=2+INT(RND(1)*35):GOTO 330
2200 IF C=1 THEN T$="The queen is already with you!":GOTO 2900
2210 T$="Hint about the queen? Y/N":GOSUB 9000
2220 IF K=78 THEN 3000
2230 IF K<>89 THEN GOSUB 9100:GOTO 2220
2240 V=1+INT(RND(1)*E):E=E-V
2250 CLS:PRINT "QUEEN: ROOM ";A(7);" COST ";V;
2260 GOSUB 9100:GOTO 3000
2900 GOSUB 9000
3000 IF E<0 THEN 8100
3010 GOTO 200
8000 T$="Expedition abandoned.":GOTO 8300
8100 T$="No gold left! You lose.":GOTO 8300
8200 T$="Well done! The queen is safe!"
8300 GOSUB 9000:CLS:PRINT "GOLD LEFT: ";E;:END
9000 CLS:PRINT T$;:GOSUB 9100:RETURN
9100 IF INKEY(0)<>0 THEN 9100
9110 K=INKEY(0):IF K=0 THEN 9110
9120 IF K>=97 AND K<=122 THEN K=K-32
9130 RETURN
