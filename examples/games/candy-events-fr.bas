10 REM EVENEMENTS DU JEU - DEMONSTRATION
20 FOR E=0 TO 2
30 P=100
40 IF E=0 THEN P=INT(P*1.7):A$="PENURIE DE COLA"
50 IF E=1 THEN P=INT(P*.6):A$="SURPLUS DE COLA"
60 IF E=2 THEN P=INT(P*1.5):A$="MODE: COLA"
70 CLS:PRINT A$;" $";P;
80 K=INKEY(0):IF K=0 THEN 80
90 NEXT E
100 PRINT "DANS LE JEU: 30% PAR ARRIVEE"
