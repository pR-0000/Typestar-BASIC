10 REM BATAILLE NAVALE - CHASSE SOLO
20 DIM B(6,6):DIM T(6,6):DIM H(3):DIM L(3)
30 L(1)=3:L(2)=2:L(3)=2
40 CLS:CURSOR 4:PRINT "BATAILLE NAVALE - ENTREE";
45 G=1
50 G=G+1:IF G>65535 THEN G=1
52 IF INKEY(0)<>13 THEN 50
54 RANDOMIZE G
60 FOR S=1 TO 3
70 D=INT(RND(1)*2):X=INT(RND(1)*6)+1
80 Y=INT(RND(1)*6)+1:U=1-D:V=D
90 IF X+U*(L(S)-1)>6 THEN 70
100 IF Y+V*(L(S)-1)>6 THEN 70
110 F=0:FOR I=0 TO L(S)-1
120 IF B(X+U*I,Y+V*I)<>0 THEN F=1
130 NEXT I:IF F=1 THEN 70
140 FOR I=0 TO L(S)-1:B(X+U*I,Y+V*I)=S:NEXT I
150 NEXT S
160 DRAW DEFERRED:BOX 0,0,120,24,1,0
170 LINE 8,16,100,16,2:LINE 100,16,112,8,2
180 LINE 48,16,48,4,1:LINE 48,4,68,12,1
190 DRAW PRINT:ORIGIN:FEED 12:ORIGIN:LSPACING 1.5
200 LPRINT "BATAILLE NAVALE - CHASSE SOLO"
210 LPRINT "3 NAVIRES : 3, 2 ET 2 CASES. 24 TIRS."
220 LPRINT "    A  B  C  D  E  F"
230 FOR Y=1 TO 6
240 LPRINT Y;"  [ ][ ][ ][ ][ ][ ]"
250 NEXT Y
260 LPRINT "X = TOUCHE   O = EAU   # = NAVIRE REVELE"
270 LPRINT "Les navires peuvent se toucher."
280 N=0:K=0:C=0
290 LLOCATE 13,1:CLS
300 REM COORDONNEES SUR LE LCD
310 INPUT "A1-F6 Q=FIN";A$
320 IF A$="Q" OR A$="q" THEN 700
330 IF LEN(A$)<>2 THEN 600
340 X=ASC(LEFT$(A$,1)):IF X>96 THEN X=X-32
350 X=X-64:Y=ASC(RIGHT$(A$,1))-48
360 IF X<1 OR X>6 OR Y<1 OR Y>6 THEN 600
370 IF T(X,Y)=1 THEN 620
380 T(X,Y)=1:N=N+1:S=B(X,Y):M$="O":R$="A L'EAU"
390 IF S=0 THEN 450
400 K=K+1:H(S)=H(S)+1:M$="X":R$="TOUCHE !"
410 IF H(S)=L(S) THEN C=C+1:R$="COULE !"
450 LLOCATE Y+3,3*X+2:LPRINT M$;
460 LLOCATE 13,1:CLS:PRINT R$;" ";N;"/24 ";K;"/7";
470 IF S=0 THEN 476
472 SOUND 700,120:GOTO 480
476 SOUND 300,60
480 IF K=7 THEN 750
490 IF N=24 THEN 700
500 GOSUB 900:GOTO 290
600 CLS:PRINT "Saisir A1 a F6, ou Q";
610 GOSUB 900:GOTO 290
620 CLS:PRINT "Case deja visee : tir conserve";:GOTO 610
700 FOR Y=1 TO 6:FOR X=1 TO 6
710 IF B(X,Y)=0 OR T(X,Y)=1 THEN 730
720 LLOCATE Y+3,3*X+2:LPRINT "#";
730 NEXT X:NEXT Y:R$="FIN DE MISSION":GOTO 760
750 R$="VICTOIRE !":SOUND 440,100:SOUND 700,150
760 LLOCATE 12,1:LPRINT R$;"  TIRS:";N;" TOUCHES:";K;"/7"
770 LLOCATE 15,1:CLS:PRINT R$;" EN ";N;" TIRS";
780 END
900 IF INKEY(0)<>0 THEN 900
910 IF INKEY(0)<>13 THEN 910
920 RETURN
