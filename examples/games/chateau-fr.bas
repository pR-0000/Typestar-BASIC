10 REM CHATEAU - ALAIN DUBUS - TYPESTAR 1.0
20 CLS:CURSOR 4:PRINT "CHÂTEAU - SAUVEZ LA REINE";
30 S=1
40 S=S MOD 60000+1:IF INKEY(0)=0 THEN 40
50 RANDOMIZE S:DIM A(12):DIM B(4)
60 FOR I=0 TO 12
70 V=2+INT(RND(1)*35):F=0
80 IF I=0 THEN 120
90 FOR J=0 TO I-1
100 IF A(J)=V THEN F=1
110 NEXT J:IF F=1 THEN 70
120 A(I)=V:NEXT I
130 E=100:C=0:T=1
140 T$="8/N nord 2/S sud 4/6 ou flèches":GOSUB 9000
150 T$="Ramenez la reine en salle 1.":GOSUB 9000
160 T$="Chaque pas coûte 8 or. Q: fin.":GOSUB 9000
200 CLS:PRINT "SALLE ";T;" OR ";E;
210 IF C=1 THEN PRINT " REINE";
220 GOSUB 9100:IF K=81 THEN 8000
230 U=T
240 IF K=56 OR K=78 THEN U=T-6
250 IF K=50 OR K=83 THEN U=T+6
260 IF K=52 OR K=18 OR K=79 THEN U=T-1
270 IF K=54 OR K=19 OR K=69 THEN U=T+1
280 IF U=T THEN 220
290 IF U<1 OR U>36 THEN 400
300 IF U=T-1 AND T MOD 6=1 THEN 400
310 IF U=T+1 AND T MOD 6=0 THEN 400
320 T=U
330 E=E-8:IF E<0 THEN 8100
340 IF C=1 AND T=1 THEN 8200
350 P=-1:FOR I=0 TO 12
360 IF A(I)=T THEN P=I
370 NEXT I:IF P<0 THEN 200
380 IF P<5 THEN 1000
390 A(P)=0:GOTO 2000
400 T$="Un mur. Choisissez une direction":GOSUB 9000
410 GOTO 200
1000 IF B(P)=1 THEN 200
1010 T$="OURS":R=20+P*5
1020 IF P=1 THEN T$="OGRE"
1030 IF P=2 THEN T$="LION"
1040 IF P=3 THEN T$="DRACULA"
1050 IF P=4 THEN T$="DRAGON"
1060 CLS:PRINT T$;" C:COMBAT F:FUITE";
1070 GOSUB 9100
1080 IF K=70 THEN E=E-10:GOTO 1130
1090 IF K<>67 THEN 1070
1100 IF RND(1)<0.4 THEN E=E-R:GOTO 1140
1110 B(P)=1:E=E+R:T$="Victoire! Le monstre est vaincu."
1120 GOSUB 9000:GOTO 3000
1130 T$="Fuite! Vous perdez 10 or.":GOSUB 9000:GOTO 3000
1140 T$="Combat perdu. Or en moins."
1150 GOSUB 9000:GOTO 3000
2000 IF P=5 THEN E=E+60:T$="Trésor! +60 or":GOTO 2900
2010 IF P=6 THEN E=E+50:T$="Rubis! +50 or":GOTO 2900
2020 IF P=7 THEN C=1:T$="La reine vous accompagne!":GOTO 2900
2030 IF P=8 OR P=9 THEN 2100
2040 IF P=10 THEN 2200
2050 V=10+INT(RND(1)*50)
2060 IF V<15 THEN E=E-2*V:T$="Le coffre explose!":GOTO 2900
2070 E=E+V:CLS:PRINT "COFFRE: +";V;" OR";
2080 GOSUB 9100:GOTO 3000
2100 T$="Catapulte! Vous êtes projeté.":GOSUB 9000
2110 T=2+INT(RND(1)*35):GOTO 330
2200 IF C=1 THEN T$="La reine est déjà avec vous!":GOTO 2900
2210 T$="Un tuyau sur la reine? O/N":GOSUB 9000
2220 IF K=78 THEN 3000
2230 IF K<>79 THEN GOSUB 9100:GOTO 2220
2240 V=1+INT(RND(1)*E):E=E-V
2250 CLS:PRINT "REINE: SALLE ";A(7);" PRIX ";V;
2260 GOSUB 9100:GOTO 3000
2900 GOSUB 9000
3000 IF E<0 THEN 8100
3010 GOTO 200
8000 T$="Expédition abandonnée.":GOTO 8300
8100 T$="Plus d'or! Vous avez perdu.":GOTO 8300
8200 T$="Bravo! La reine est sauvée!"
8300 GOSUB 9000:CLS:PRINT "OR RESTANT: ";E;:END
9000 CLS:PRINT T$;:GOSUB 9100:RETURN
9100 IF INKEY(0)<>0 THEN 9100
9110 K=INKEY(0):IF K=0 THEN 9110
9120 IF K>=97 AND K<=122 THEN K=K-32
9130 RETURN
