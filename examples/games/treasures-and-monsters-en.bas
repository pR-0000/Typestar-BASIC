1 REM TREASURES AND MONSTERS - PHILIPPE LESOT
2 REM HEBDOGICIEL 16 - 27 JANUARY 1984 - SHARP PC-1211
10 CLS:PRINT "TREASURES AND MONSTERS - ANY KEY";
20 S=1
30 K=INKEY(0):IF K<>0 THEN 60
40 S=S+1:IF S>65535 THEN S=1
50 GOTO 30
60 RANDOMIZE S:DIM P(4,8)
70 INPUT "PLAYERS 1-4";N
80 IF N<>INT(N) OR N<1 OR N>4 THEN 70
90 FOR I=1 TO N
100 P(I,1)=INT(RND(1)*20)+1:P(I,8)=P(I,1)
110 P(I,4)=3:P(I,5)=1
120 GOSUB 8000:NEXT I
130 D=INT(RND(1)*50)+1
140 FOR I=1 TO N
150 IF P(I,1)<1 OR P(I,7)>D THEN 290
160 P(I,2)=P(I,2)+INT(RND(1)*6)+1:GOSUB 8000
170 INPUT "ADVANCE 0-3";A
180 IF A<>INT(A) OR A<0 OR A>3 THEN 170
190 P(I,2)=P(I,2)-A-1:IF P(I,2)<0 THEN 280
200 P(I,7)=P(I,7)+A:IF A>0 THEN 240
210 INPUT "HEAL 0=NO 1=YES";B
220 IF B<>0 AND B<>1 THEN 210
230 IF B=1 THEN GOSUB 2000
232 IF P(I,1)<1 THEN 280
234 IF RND(1)<0.5 THEN 290
240 T=INT(RND(1)*9)+1
250 IF T>6 THEN GOSUB 3000:GOTO 270
260 GOSUB 4000
270 IF P(I,1)>0 THEN 290
280 P(I,1)=0:T$="P"+STR$(I)+" HAS DIED":GOSUB 8500
290 NEXT I
300 L=0:R=0
310 FOR I=1 TO N
320 IF P(I,1)>0 THEN L=L+1
330 IF P(I,1)>0 AND P(I,7)<=D THEN R=R+1
340 NEXT I
350 IF L=0 THEN T$="EVERYONE HAS DIED!":GOSUB 8500:END
360 IF R>0 THEN 140
370 GOTO 9000
2000 P(I,2)=P(I,2)-1
2010 IF P(I,2)<0 THEN P(I,1)=0:RETURN
2020 P(I,1)=P(I,1)+INT(RND(1)*6)+1
2030 IF P(I,1)>P(I,8) THEN P(I,1)=P(I,8)
2040 T$="HEALING: HEALTH "+STR$(P(I,1)):GOSUB 8500:RETURN
3000 T=INT(RND(1)*6)+1:B=1
3010 IF T<4 THEN B=INT(RND(1)*6)+1
3020 IF T=6 THEN 3100
3030 P(I,T)=P(I,T)+B
3040 T$="TREASURE: HEALTH"
3050 IF T=2 THEN T$="TREASURE: FOOD"
3060 IF T=3 THEN T$="TREASURE: GOLD"
3070 IF T=4 THEN T$="TREASURE: STRENGTH"
3080 IF T=5 THEN T$="TREASURE: VIAL"
3090 T$=T$+" +"+STR$(B):GOSUB 8500:RETURN
3100 T$="POISON! VIALS "+STR$(P(I,5)):GOSUB 8500
3110 IF P(I,5)<1 THEN 3150
3120 INPUT "VIAL 0=NO 1=YES";B
3130 IF B<>0 AND B<>1 THEN 3120
3140 IF B=1 THEN P(I,5)=P(I,5)-1:RETURN
3150 P(I,1)=P(I,1)-3:T$="POISON: HEALTH -3"
3160 GOSUB 8500:RETURN
4000 E=6:F=4:G=4:M$="GHOUL":U=0:V=1
4010 IF T=1 THEN E=3:G=3:M$="ORC"
4020 IF T=3 THEN M$="ZOMBIE":U=2:V=3
4030 IF T=4 THEN E=8:M$="DEMON":U=2:V=3
4040 IF T=5 THEN E=9:F=5:M$="TROLL":U=1:V=3
4050 IF T=6 THEN E=15:F=6:G=6:M$="DRAGON"
4060 T$=M$+" - HEALTH "+STR$(E):GOSUB 8500
4070 IF U=0 THEN T$="0 HIDE   1 ATTACK"
4080 IF U=1 THEN T$="1 ATTACK   3 GOLD"
4090 IF U=2 THEN T$="2 DEFEND   3 GOLD"
4100 GOSUB 8500:INPUT "ACTION";C
4110 IF C<>U AND C<>V THEN 4070
4120 IF C=3 AND P(I,3)>0 THEN 4600
4130 IF C=1 THEN 4400
4140 IF C=0 AND RND(1)<1/3 THEN 4610
4200 B=INT(RND(1)*6)+1
4210 IF B<P(I,4)+1 THEN 4400
4220 B=INT(RND(1)*G)+1:P(I,1)=P(I,1)-B
4230 T$=M$+" : HEALTH -"+STR$(B):GOSUB 8500
4240 IF P(I,1)<1 THEN RETURN
4400 B=INT(RND(1)*6)+1
4410 IF P(I,4)+B<F+3 THEN 4200
4420 B=INT(RND(1)*P(I,4))+1:E=E-B
4430 IF E<1 THEN 4500
4440 T$=M$+" : LEFT "+STR$(E):GOSUB 8500:GOTO 4200
4500 P(I,6)=P(I,6)+1
4510 IF P(I,6) MOD 5=0 THEN P(I,8)=P(I,8)+1
4520 T$=M$+" DEFEATED!":GOSUB 8500
4530 IF F<5 THEN RETURN
4540 B=INT(RND(1)*6)+1:P(I,3)=P(I,3)+B
4550 T$="LOOT: GOLD +"+STR$(B):GOSUB 8500:RETURN
4600 P(I,3)=P(I,3)-1:T$="PASSAGE BOUGHT: GOLD -1"
4605 GOSUB 8500:RETURN
4610 T$="WELL HIDDEN!":GOSUB 8500:RETURN
8000 CLS:PRINT "P";I;" ROOM ";P(I,7);" HP ";P(I,1);
8010 PRINT "/";P(I,8);:GOSUB 8600
8020 CLS:PRINT "FOOD ";P(I,2);" STR ";P(I,4);
8030 PRINT " GOLD ";P(I,3);:GOSUB 8600
8040 CLS:PRINT "VIALS ";P(I,5);" KILLS ";P(I,6);
8050 GOSUB 8600:RETURN
8500 CLS:PRINT T$;:GOSUB 8600:RETURN
8600 K=INKEY(0):IF K=0 THEN 8600
8610 RETURN
9000 T$="DUNGEON CROSSED!":GOSUB 8500:W=-1
9010 FOR I=1 TO N
9020 IF P(I,1)>0 AND P(I,3)>W THEN W=P(I,3)
9030 NEXT I
9040 FOR I=1 TO N
9050 IF P(I,1)<1 OR P(I,3)<>W THEN 9080
9060 T$="WINNER P"+STR$(I)+" - GOLD "+STR$(W)
9070 GOSUB 8500
9080 NEXT I
9090 END
