10 REM MANOIR DU COMTE ZORCK - TYPESTAR 1.0
20 CLS:CURSOR 4:PRINT "LE MANOIR DU COMTE ZORCK";
30 S=1
40 S=S MOD 65000+1:K=INKEY(0):IF K=0 THEN 40
50 RANDOMIZE S:DIM Z(4)
60 M$="11222222331122222233222333333322223222322223223322"
70 N$="22232223222333333322232222232233222223223222222333"
80 O$="32222223223244444544444266656644426877762222666666"
90 H=80+INT(RND(1)*21):G=0:X=0:Y=0:F=0
100 T$="Explorez. Revenez avec le butin.":GOSUB 9000
110 T$="N S E O: marcher. I: etat Q: fin":GOSUB 9000
120 I=10*Y+X:GOSUB 500:T$="BROUILLARD"
130 IF A=1 THEN T$="VILLAGE"
140 IF A=3 THEN T$="CHEMIN"
150 IF A=5 THEN T$="ENTREE DU MANOIR"
160 IF A=7 THEN T$="MANOIR"
170 IF A=8 THEN 1000
180 IF A=1 AND G>0 THEN 8000
190 CLS:PRINT T$;" ";X;",";Y;
200 GOSUB 9100:IF K=81 THEN 8100
210 IF K=73 THEN GOSUB 9200:GOTO 190
220 U=X:V=Y
230 IF K=78 THEN V=V-1
240 IF K=83 THEN V=V+1
250 IF K=69 OR K=19 THEN U=U+1
260 IF K=79 OR K=18 THEN U=U-1
270 IF U=X AND V=Y THEN 200
280 IF U<0 OR U>9 OR V<0 OR V>14 THEN 340
290 I=10*V+U:GOSUB 500:IF A=4 OR A=6 THEN 340
300 X=U:Y=V
310 IF INT(RND(1)*(10-A))=0 THEN GOSUB 6000
320 IF H<=0 THEN 8200
330 GOTO 120
340 T$="Passage impossible.":GOSUB 9000:GOTO 120
500 IF I<50 THEN A=ASC(MID$(M$,I+1,1))-48:RETURN
510 IF I<100 THEN A=ASC(MID$(N$,I-49,1))-48:RETURN
520 A=ASC(MID$(O$,I-99,1))-48:RETURN
1000 IF F=1 THEN 3000
1010 T$="Porte cachee: trouvez X et Y.":GOSUB 9000
1020 C=INT(RND(1)*400)-199:D=INT(RND(1)*200)-99
1030 B=50:U=0:V=0
1040 T$="X: -200..200 / Y: -100..100":GOSUB 9000
1050 A=SQR((C-U)^2+(D-V)^2)
1060 IF A=0 THEN 1200
1070 CLS:PRINT "DIST ";INT(A*10)/10;" ESSAIS ";B;
1080 GOSUB 9100:INPUT "X";U:INPUT "Y";V
1090 IF U<-200 OR U>200 OR V<-100 OR V>100 THEN 1080
1100 B=B-1:IF B=0 THEN 8300
1110 GOTO 1050
1200 T$="Porte trouvee! Mot de passe.":GOSUB 9000
1210 J=INT(RND(1)*16)+1
1220 FOR I=1 TO J:READ R$:NEXT I
1230 Q$="":FOR I=1 TO LEN(R$):Q$=Q$+"-":NEXT I
1240 CLS:PRINT Q$;" ESSAIS ";B;
1250 GOSUB 9100:IF K<65 OR K>90 THEN 1250
1260 A$=CHR$(K):T$=""
1270 FOR I=1 TO LEN(R$)
1280 IF MID$(R$,I,1)=A$ THEN T$=T$+A$:GOTO 1300
1290 T$=T$+MID$(Q$,I,1)
1300 NEXT I:Q$=T$:B=B-1
1310 IF B=0 THEN 8300
1320 IF Q$=R$ THEN 1400
1330 GOTO 1240
1400 T$="Encore une porte! Code chiffre.":GOSUB 9000
1410 N=INT(RND(1)*3)+4:R$=""
1420 A$=CHR$(48+INT(RND(1)*10)):V=0
1430 IF LEN(R$)=0 THEN 1455
1440 FOR I=1 TO LEN(R$)
1445 IF MID$(R$,I,1)=A$ THEN V=1
1450 NEXT I:IF V=1 THEN 1420
1455 R$=R$+A$:IF LEN(R$)<N THEN 1420
1460 CLS:PRINT N;" CHIFFRES / ESSAIS ";B;
1470 INPUT "CODE";A$:IF LEN(A$)<>N THEN 1460
1480 V=0:FOR I=1 TO N:K=ASC(MID$(A$,I,1))
1490 IF K<48 OR K>57 THEN V=1
1492 FOR J=1 TO N
1494 IF I<>J AND MID$(A$,I,1)=MID$(A$,J,1) THEN V=1
1496 NEXT J
1500 NEXT I:IF V=1 THEN 1460
1505 U=0:V=0
1510 FOR I=1 TO N:FOR J=1 TO N
1520 IF MID$(R$,I,1)<>MID$(A$,J,1) THEN 1550
1530 IF I=J THEN U=U+1 ELSE V=V+1
1550 NEXT J:NEXT I
1560 B=B-1:IF U=N THEN F=1:GOTO 3000
1570 IF B=0 THEN 8300
1580 CLS:PRINT "BIEN ";U;" MAL ";V;" RESTE ";B;
1590 GOSUB 9100:GOTO 1460
3000 T$="Donjon: 8 N / 2 S / 4 O / 6 E":GOSUB 9000
3010 T$="Diagonales 1 3 7 9. I: etat.":GOSUB 9000
3020 T$="Centre: M/D etages. 5: sortie":GOSUB 9000
3030 X=3:Y=3:E=0
3040 CLS:PRINT "ETAGE ";E;" X";X;" Y";Y;" PV";H;
3050 GOSUB 9100:IF K=73 THEN GOSUB 9200:GOTO 3040
3060 IF K=53 THEN X=6:Y=13:GOTO 120
3070 IF K=77 OR K=68 THEN 3300
3080 U=X:V=Y
3090 IF K=49 OR K=52 OR K=55 OR K=18 THEN U=U-1
3100 IF K=51 OR K=54 OR K=57 OR K=19 THEN U=U+1
3110 IF K=55 OR K=56 OR K=57 THEN V=V-1
3120 IF K=49 OR K=50 OR K=51 THEN V=V+1
3130 IF U=X AND V=Y THEN 3050
3140 IF U<1 OR U>5 OR V<1 OR V>5 THEN 3280
3150 IF U MOD 2=0 AND V MOD 2=0 THEN 3280
3160 IF U<>X AND V<>Y THEN 3260
3170 X=U:Y=V:A=0
3180 IF X=1 AND Y=1 THEN A=1
3190 IF X=5 AND Y=1 THEN A=2
3200 IF X=1 AND Y=5 THEN A=4
3210 IF X=5 AND Y=5 THEN A=8
3220 IF A=0 THEN 3040
3230 IF (Z(E) AND A)<>0 THEN 3040
3240 GOSUB 6100:IF H<=0 THEN 8200
3245 Z(E)=Z(E)+A:G=G+INT(RND(1)*200)+1
3250 T$="Garde vaincu. Tresor ramasse!":GOSUB 9000
3255 GOTO 3040
3260 IF X MOD 2=0 AND V MOD 2=0 THEN 3280
3270 IF U MOD 2=0 AND Y MOD 2=0 THEN 3280
3275 GOTO 3170
3280 T$="Un mur! Faites le tour.":GOSUB 9000:GOTO 3040
3300 IF X<>3 OR Y<>3 THEN 3280
3310 IF K=77 AND E<4 THEN E=E+1:GOTO 3040
3320 IF K=68 AND E>0 THEN E=E-1:GOTO 3040
3330 T$="Etage limite. 5 pour sortir.":GOSUB 9000:GOTO 3040
6000 J=INT(RND(1)*10):T$="GARDE"
6010 IF J=1 THEN T$="MONSTRE"
6020 IF J=2 THEN T$="NAIN"
6030 IF J=3 THEN T$="ROBOT"
6040 IF J=4 THEN T$="BLOB"
6050 IF J=5 THEN T$="SERPENT"
6060 IF J=6 THEN T$="SERGENT XOR"
6070 IF J=7 THEN T$="TRAITRE"
6080 IF J=8 THEN T$="MAGICIEN"
6090 IF J=9 THEN T$="CHIEN"
6095 GOTO 6110
6100 T$="GARDE DU TRESOR"
6110 GOSUB 9000:L=INT(RND(1)*7)+1
6120 IF RND(1)<0.35 THEN H=H-INT(RND(1)*5)-1
6130 IF H<=0 THEN RETURN
6140 IF RND(1)<0.5 THEN L=L-INT(RND(1)*5)-1
6150 CLS:PRINT "COMBAT PV ";H;" ENNEMI ";L;
6160 SOUND 0,250:IF L>0 THEN 6120
6170 RETURN
8000 T$="Retour au village. Victoire!":GOSUB 9000
8010 GOTO 8110
8100 T$="Expedition abandonnee.":GOSUB 9000
8110 CLS:PRINT "BUTIN ";G;" $  PV ";H;:END
8200 T$="Vous avez rejoint vos ancetres.":GOSUB 9000
8210 GOTO 8110
8300 T$="Trop tard! Le donjon s'ecroule.":GOSUB 9000
8310 H=0:GOTO 8110
9000 CLS:PRINT T$;:GOSUB 9100:RETURN
9100 IF INKEY(0)<>0 THEN 9100
9110 K=INKEY(0):IF K=0 THEN 9110
9120 IF K>=97 AND K<=122 THEN K=K-32
9130 RETURN
9200 CLS:PRINT "VIE ";H;" BUTIN ";G;" $";
9210 GOSUB 9100:RETURN
